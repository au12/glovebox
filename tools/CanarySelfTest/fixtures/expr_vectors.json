{
  "description": "Shared test vectors for the profile expression language. The firmware (C) and Glovebox (C#) must agree on every one. null means 'not available' (NaN).",
  "vars": ["a", "b", "c", "rpm", "boost_target", "boost_actual"],
  "cases": [
    { "expr": "1 + 2 * 3", "vars": {}, "expect": 7 },
    { "expr": "(1 + 2) * 3", "vars": {}, "expect": 9 },
    { "expr": "10 / 4", "vars": {}, "expect": 2.5 },
    { "expr": "10 % 4", "vars": {}, "expect": 2 },
    { "expr": "-a + 1", "vars": { "a": 3 }, "expect": -2 },
    { "expr": "a - -b", "vars": { "a": 3, "b": 2 }, "expect": 5 },
    { "expr": "!a", "vars": { "a": 0 }, "expect": 1 },
    { "expr": "!a", "vars": { "a": 5 }, "expect": 0 },
    { "expr": "a > b", "vars": { "a": 3, "b": 2 }, "expect": 1 },
    { "expr": "a >= 3 && b < 2", "vars": { "a": 3, "b": 2 }, "expect": 0 },
    { "expr": "a >= 3 || b < 2", "vars": { "a": 3, "b": 2 }, "expect": 1 },
    { "expr": "a == 3", "vars": { "a": 3 }, "expect": 1 },
    { "expr": "a != 3", "vars": { "a": 3 }, "expect": 0 },
    { "expr": "a <= b", "vars": { "a": 2, "b": 2 }, "expect": 1 },
    { "expr": "abs(a - b)", "vars": { "a": 2, "b": 7 }, "expect": 5 },
    { "expr": "min(a, b) + max(a, b)", "vars": { "a": 2, "b": 7 }, "expect": 9 },
    { "expr": "max(max(abs(a), abs(b)), abs(c))", "vars": { "a": -4, "b": 3, "c": 1 }, "expect": 4 },
    { "expr": "if(a > 1, b, c)", "vars": { "a": 2, "b": 10, "c": 20 }, "expect": 10 },
    { "expr": "if(a > 1, b, c)", "vars": { "a": 0, "b": 10, "c": 20 }, "expect": 20 },
    { "expr": "boost_target - boost_actual", "vars": { "boost_target": 220, "boost_actual": 191.5 }, "expect": 28.5 },
    { "expr": "rpm > 2000 && boost_target > 135", "vars": { "rpm": 3100, "boost_target": 180 }, "expect": 1 },
    { "expr": "a + b", "vars": { "a": 1 }, "expect": null },
    { "expr": "a > 1 || b > 1", "vars": { "a": 5 }, "expect": null },
    { "expr": "a / b", "vars": { "a": 1, "b": 0 }, "expect": null },
    { "expr": "a % b", "vars": { "a": 1, "b": 0 }, "expect": null },
    { "expr": "if(a, b, c)", "vars": { "a": 1, "b": 2 }, "expect": null },
    { "expr": "1 < 2 == 1", "vars": {}, "error": true },
    { "expr": "a +", "vars": {}, "error": true },
    { "expr": "unknown_signal + 1", "vars": {}, "error": true },
    { "expr": "min(a)", "vars": {}, "error": true },
    { "expr": "(a + b", "vars": {}, "error": true },
    { "expr": "2 * (3 + 4) - 5 / (1 + 1)", "vars": {}, "expect": 11.5 },
    { "expr": "1.5e2 + .5", "vars": {}, "expect": 150.5 },
    { "expr": "a>1&&b>1||c>1", "vars": { "a": 0, "b": 0, "c": 2 }, "expect": 1 },
    { "expr": "-(a + b) * 2", "vars": { "a": 1, "b": 2 }, "expect": -6 },
    { "expr": "!(a > b)", "vars": { "a": 1, "b": 2 }, "expect": 1 }
  ]
}

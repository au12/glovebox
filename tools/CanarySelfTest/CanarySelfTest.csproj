<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the CANary analysis code against the device firmware: the shared expression vectors, and a
       recorded drive whose verdicts the device computed itself. Run with:
         dotnet run (with the project option pointing at tools/CanarySelfTest) -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CarCareTracker.CanarySelfTest</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Logic/Canary/*.cs" LinkBase="Canary" />
    <None Include="fixtures/**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

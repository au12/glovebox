@model OdometerViewModel
@{
    var digits = Model.Value.ToString().PadLeft(Model.MinDigits, '0');
    var count = digits.Length;
}
<span class="gb-odo @Model.Size @(Model.Roll ? "gb-odo--roll" : "")">
    <span class="gb-odo-drums" aria-hidden="true">
        @for (int i = 0; i < count; i++)
        {
            var digit = digits[i] - '0';
            <span class="gb-odo-drum @(i == count - 1 ? "last" : "")"><span class="gb-odo-strip" style="--d:@digit; --i:@i"><span>0</span><span>1</span><span>2</span><span>3</span><span>4</span><span>5</span><span>6</span><span>7</span><span>8</span><span>9</span></span></span>
        }
    </span>
    <span class="gb-odo-unit" aria-hidden="true">@Model.Unit</span>
    <span class="visually-hidden">@Model.Value.ToString("N0") @Model.Unit</span>
</span>

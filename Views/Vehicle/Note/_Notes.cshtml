@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model List<Note>
@{
    var recordTags = Model.SelectMany(x => x.Tags).Distinct();
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
<div class="d-flex flex-column vehicleTabPane">
<div class="row">
    <div class="d-flex justify-content-between">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="badge" data-aggregate-type="count" data-one="@translator.Translate(userLanguage, "note")" data-many="@translator.Translate(userLanguage, "notes")">@GloveboxFormat.Count(Model.Count(), translator.Translate(userLanguage, "note"), translator.Translate(userLanguage, "notes"))</span>
            @foreach (string recordTag in recordTags)
            {
                <span onclick="filterTable('notes-tab-pane', this)" class="user-select-none rounded-pill badge bg-secondary tagfilter" style="cursor:pointer;">@recordTag</span>
            }
            <datalist id="tagList">
                @foreach (string recordTag in recordTags)
                {
                    <!option value="@recordTag"></!option>
                }
            </datalist>
        </div>
        <div class="lubelogger-record-add">
            <div class="btn-group">
                <button onclick="showAddNoteModal()" class="btn btn-primary btn-md"><i class="bi bi-plus-lg"></i><span class="gb-btn-label">@translator.Translate(userLanguage, "Add note")</span></button>
                <button type="button" class="btn btn-md btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">@translator.Translate(userLanguage, "More actions")</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end record-dropdown">
                    <li><a class="dropdown-item" href="#" onclick="printTab()"><i class="bi bi-printer"></i>@translator.Translate(userLanguage, "Print")</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <div class="list-group-item">
                            <input class="btn-check" type="checkbox" id="chkSelectMode" onchange="checkSelectModeToggle()">
                            <label class="dropdown-item" for="chkSelectMode"><i class="bi bi-check2-square"></i>@translator.Translate(userLanguage, "Select mode")</label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row vehicleDetailTabContainer flex-grow-1">
    <div class="col-12">
        <div class="row mt-2 showOnPrint">
            <div class="d-flex">
                <img src="@config.GetLogoUrl()" class="lubelogger-logo" />
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="gb-history">
                <div class="gb-due-empty">
                    <i class="bi bi-journal-text" style="color:var(--gb-text-3)"></i>
                    <div class="flex-grow-1">
                        <strong class="d-block">@translator.Translate(userLanguage, "No notes yet")</strong>
                        <span>@translator.Translate(userLanguage, "Keep tire sizes, part numbers, torque specs and anything else you'd otherwise lose. Markdown and attachments are supported.")</span>
                    </div>
                    <button type="button" class="btn btn-secondary" onclick="showAddNoteModal()"><i class="bi bi-plus-lg"></i>@translator.Translate(userLanguage, "Add note")</button>
                </div>
            </div>
        }
        <table class="table @(Model.Any() ? "" : "d-none")">
            <thead class="sticky-top">
                <tr class="d-flex">
                    <th scope="col" class="col-4 flex-grow-1" data-column="description">@translator.Translate(userLanguage, "Description")</th>
                    <th scope="col" class="col-8 flex-grow-1" data-column="notes">@translator.Translate(userLanguage, "Note")</th>
                    <th scope="col" class="col-1 flex-grow-1" data-column="attachments">@translator.Translate(userLanguage, "Attachments")</th>
                </tr>
            </thead>
            <tbody>
                @foreach (Note note in Model)
                {
                    var images = note.Files.Where(x => GloveboxFormat.FileKind(x.Location) == "image").Take(3).ToList();
                    var otherCount = note.Files.Count - images.Count;
                    <tr class="d-flex user-select-none" style="cursor:pointer;" onmouseup="stopEvent()" ontouchstart="detectRowLongTouch(this)" ontouchend="detectRowTouchEndPremature(this)" data-rowId="@note.Id" oncontextmenu="showTableContextMenu(this)" onmousemove="rangeMouseMove(this)" onclick="handleTableRowClick(this, showNoteViewer, @note.Id)" data-tags='@string.Join(" ", note.Tags)'>
                        <td class="col-4 flex-grow-1" data-column="description">@if (note.Pinned){<i class='bi bi-pin-fill' title="@translator.Translate(userLanguage, "Pinned")"></i>}@note.Description</td>
                        <td class="col-8 flex-grow-1" data-column="notes" data-record-type="cost">@GloveboxFormat.MarkdownExcerpt(note.NoteText, 320)</td>
                        <td class="col-1 flex-grow-1" data-column="attachments">@if (note.Files.Any() || note.Tags.Any())
                            {
                                <div class="gb-note-foot">
                                    @if (images.Any())
                                    {
                                        <span class="gb-note-thumbs">
                                            @foreach (var image in images)
                                            {
                                                <img src="@image.Location" alt="" loading="lazy" />
                                            }
                                        </span>
                                    }
                                    @if (otherCount > 0)
                                    {
                                        <span class="gb-note-chip"><i class="bi bi-paperclip"></i>@otherCount</span>
                                    }
                                    @foreach (var tag in note.Tags)
                                    {
                                        <span class="gb-note-chip">@tag</span>
                                    }
                                </div>
                            }</td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="d-flex">
                    <td class="col-12 showOnPrint lubelogger-report-banner">
                        @StaticHelper.ReportNote
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
</div>

<div class="modal fade" data-bs-focus="false" id="noteModal" tabindex="-1" role="dialog" aria-hidden="true" onpaste="handleModalPaste(event)" @StaticHelper.GetStaticModalAttribute(userConfig.EnablePersistentDialog)>
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="noteModalContent">
        </div>
    </div>
</div>

<ul class="table-context-menu dropdown-menu" style="display:none;">
    <li><a class="context-menu-multiple context-menu-select-all dropdown-item" href="#" onclick="selectAllRows()"><i class="bi bi-check-square"></i><span>@translator.Translate(userLanguage, "Select all")</span></a></li>
    <li><a class="context-menu-multiple context-menu-deselect-all dropdown-item" href="#" onclick="clearSelectedRows()"><i class="bi bi-x-square"></i><span>@translator.Translate(userLanguage, "Deselect all")</span></a></li>
    <li><hr class="context-menu-multiple dropdown-divider"></li>
    <li><a class="dropdown-item" href="#" onclick="pinNotes(selectedRow, true)"><i class="bi bi-pin-angle-fill"></i><span>@translator.Translate(userLanguage, "Toggle pin")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="pinNotes(selectedRow, false, true)"><i class="bi bi-pin-angle-fill"></i><span>@translator.Translate(userLanguage, "Pin")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="pinNotes(selectedRow, false, false)"><i class="bi bi-pin-angle"></i><span>@translator.Translate(userLanguage, "Unpin")</span></a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="context-menu-active-single dropdown-item" href="#" onclick="showEditNoteModal(selectedRow[0])"><i class="bi bi-pencil"></i><span>@translator.Translate(userLanguage, "Edit")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="duplicateRecords(selectedRow, 'NoteRecord')"><i class="bi bi-copy"></i><span>@translator.Translate(userLanguage, "Duplicate")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="duplicateRecordsToOtherVehicles(selectedRow, 'NoteRecord')"><i class="bi bi-copy"></i><span>@translator.Translate(userLanguage, "Duplicate to vehicle")</span></a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item" href="#" onclick="printTabStickers(selectedRow, 'NoteRecord')"><i class="bi bi-printer"></i><span>@translator.Translate(userLanguage, "Print")</span></a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item text-danger" href="#" onclick="deleteRecords(selectedRow, 'NoteRecord')"><i class="bi bi-trash"></i><span>@translator.Translate(userLanguage, "Delete")</span></a></li>
</ul>

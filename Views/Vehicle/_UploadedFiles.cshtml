@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
}
@model List<UploadedFiles>
@if (Model.Any())
{
    <label id="uploadedDocumentsLabel">@translator.Translate(userLanguage, "Attachments") (@Model.Count)</label>
    <ul class="gb-files" id="uploadedDocumentsList" data-gb-gallery>
        @foreach (UploadedFiles filesUploaded in Model)
        {
            <partial name="_FileCard" model="filesUploaded" />
        }
    </ul>
}
<script>
    var uploadedFiles = [];
     @foreach (UploadedFiles filesUploaded in Model)
     {
        @:uploadedFiles.push({ name: decodeHTMLEntities("@filesUploaded.Name"), location: decodeHTMLEntities("@filesUploaded.Location") });
     }
</script>

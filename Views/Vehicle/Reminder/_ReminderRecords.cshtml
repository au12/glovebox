@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model List<ReminderRecordViewModel>
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    var hasRefresh = Model.Where(x => (x.Urgency == ReminderUrgency.VeryUrgent || x.Urgency == ReminderUrgency.PastDue) && x.IsRecurring).Any();
    var recordTags = Model.SelectMany(x => x.Tags).Distinct();
    var userColumnPreferences = userConfig.UserColumnPreferences.Where(x => x.Tab == ImportMode.ReminderRecord);
    var noteColumnStyle = userConfig.EnableNotesColumnWrap ? "text-wrap break-all" : "text-truncate";
    var noteColumnLength = userConfig.EnableNotesColumnWrap ? 100 : 40;
    var dueItems = ViewData["DueItems"] as Dictionary<int, DueItem> ?? new Dictionary<int, DueItem>();
    var unit = ViewData["DistanceUnit"] as string ?? (userConfig.UseMPG ? "mi" : "km");
    var pastDue = Model.Count(x => x.Urgency == ReminderUrgency.PastDue);
    var veryUrgent = Model.Count(x => x.Urgency == ReminderUrgency.VeryUrgent);
    var urgent = Model.Count(x => x.Urgency == ReminderUrgency.Urgent);
}
<div class="d-flex flex-column vehicleTabPane">
<div class="row">
    <div class="d-flex justify-content-between">
        <div class="d-flex align-items-center flex-wrap gap-2">
            <span class="badge" data-aggregate-type="count" data-one="@translator.Translate(userLanguage, "reminder")" data-many="@translator.Translate(userLanguage, "reminders")">@GloveboxFormat.Count(Model.Count(), translator.Translate(userLanguage, "reminder"), translator.Translate(userLanguage, "reminders"))</span>
            <span class="badge @(pastDue == 0 ? "d-none" : "")" data-aggregate-type="pastdue-count" data-one="@translator.Translate(userLanguage, "overdue")" data-many="@translator.Translate(userLanguage, "overdue")">@($"{pastDue} {translator.Translate(userLanguage, "overdue")}")</span>
            <span class="badge @(veryUrgent == 0 ? "d-none" : "")" data-aggregate-type="veryurgent-count" data-one="@translator.Translate(userLanguage, "urgent")" data-many="@translator.Translate(userLanguage, "urgent")">@($"{veryUrgent} {translator.Translate(userLanguage, "urgent")}")</span>
            <span class="badge @(urgent == 0 ? "d-none" : "")" data-aggregate-type="urgent-count" data-one="@translator.Translate(userLanguage, "due soon")" data-many="@translator.Translate(userLanguage, "due soon")">@($"{urgent} {translator.Translate(userLanguage, "due soon")}")</span>
            <span class="badge d-none" data-aggregate-type="noturgent-count" data-one="@translator.Translate(userLanguage, "upcoming")" data-many="@translator.Translate(userLanguage, "upcoming")">@($"{Model.Count(x => x.Urgency == ReminderUrgency.NotUrgent)} {translator.Translate(userLanguage, "upcoming")}")</span>
            @foreach (string recordTag in recordTags)
            {
                <span onclick="filterReminderTable(this)" class="user-select-none rounded-pill badge bg-secondary tagfilter" style="cursor:pointer;">@recordTag</span>
            }
            <datalist id="tagList">
                @foreach (string recordTag in recordTags)
                {
                    <!option value="@recordTag"></!option>
                }
            </datalist>
        </div>
        <div class="lubelogger-record-add">
            <div class="btn-group">
                <button onclick="showAddReminderModal()" class="btn btn-primary btn-md"><i class="bi bi-plus-lg"></i><span class="gb-btn-label">@translator.Translate(userLanguage, "Add reminder")</span></button>
                <button type="button" class="btn btn-md btn-primary dropdown-toggle dropdown-toggle-split" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="visually-hidden">@translator.Translate(userLanguage, "More actions")</span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end record-dropdown">
                    <li><a class="dropdown-item" href="#" onclick="printTab()"><i class="bi bi-printer"></i>@translator.Translate(userLanguage, "Print")</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <div class="list-group-item">
                            <input class="btn-check" type="checkbox" id="chkSelectMode" onchange="checkSelectModeToggle()">
                            <label class="dropdown-item" for="chkSelectMode"><i class="bi bi-check2-square"></i>@translator.Translate(userLanguage, "Select mode")</label>
                        </div>
                    </li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">@translator.Translate(userLanguage, "Columns")</h6></li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='urgency' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Urgency" checked>
                            <label class="form-check-label stretched-link" for="chkCol_Urgency">@translator.Translate(userLanguage, "Status")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='metric' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Metric" checked>
                            <label class="form-check-label stretched-link" for="chkCol_Metric">@translator.Translate(userLanguage, "Due")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='date' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Date">
                            <label class="form-check-label stretched-link" for="chkCol_Date">@translator.Translate(userLanguage, "Date")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='odometer' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Odometer">
                            <label class="form-check-label stretched-link" for="chkCol_Odometer">@translator.Translate(userLanguage, "Odometer")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='duedays' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_DueDays">
                            <label class="form-check-label stretched-link" for="chkCol_DueDays">@translator.Translate(userLanguage, "Due days")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='duedistance' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_DueDistance">
                            <label class="form-check-label stretched-link" for="chkCol_DueDistance">@translator.Translate(userLanguage, "Due distance")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='description' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Description" checked>
                            <label class="form-check-label stretched-link" for="chkCol_Description">@translator.Translate(userLanguage, "Description")</label>
                        </div>
                    </li>
                    <li class="dropdown-item">
                        <div class="list-group-item">
                            <input class="form-check-input col-visible-toggle" data-column-toggle='notes' onChange="showTableColumns(this, 'ReminderRecord')" type="checkbox" id="chkCol_Notes" checked>
                            <label class="form-check-label stretched-link" for="chkCol_Notes">@translator.Translate(userLanguage, "Notes")</label>
                        </div>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</div>
<div class="row vehicleDetailTabContainer flex-grow-1">
    <div class="col-12">
        <div class="row mt-2 showOnPrint">
            <div class="d-flex">
                <img src="@config.GetLogoUrl()" class="lubelogger-logo" />
            </div>
        </div>
        @if (!Model.Any())
        {
            <div class="gb-history">
                <div class="gb-due-empty">
                    <i class="bi bi-calendar2-check"></i>
                    <div class="flex-grow-1">
                        <strong class="d-block">@translator.Translate(userLanguage, "No reminders yet")</strong>
                        <span>@translator.Translate(userLanguage, "Set reminders by mileage, date or both. Recurring ones roll forward when you log the service.")</span>
                    </div>
                    <button type="button" class="btn btn-secondary" onclick="showAddReminderModal()"><i class="bi bi-plus-lg"></i>@translator.Translate(userLanguage, "Add reminder")</button>
                </div>
            </div>
        }
        <table class="table table-hover gb-reminder-table @(userConfig.UseGridInMobile ? "" : "ll-responsive-table") @(Model.Any() ? "" : "d-none")">
            <thead class="sticky-top">
                <tr class="d-flex">
                    <th scope="col" data-column="urgency" class="col-2 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Status")</th>
                    <th scope="col" data-column="description" class="col-3 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Reminder")</th>
                    <th scope="col" data-column="metric" class="col-3 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Due")</th>
                    <th scope="col" data-column="date" style="display:none;" class="col-2 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Date")</th>
                    <th scope="col" data-column="odometer" style="display:none;" class="col-2 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Odometer")</th>
                    <th scope="col" data-column="duedays" style="display:none;" class="col-1 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Due days")</th>
                    <th scope="col" data-column="duedistance" style="display:none;" class="col-1 flex-grow-1 flex-shrink-1 text-truncate">@translator.Translate(userLanguage, "Due distance")</th>
                    <th scope="col" data-column="notes" class="flex-grow-1 flex-shrink-1 col-2 text-truncate">@translator.Translate(userLanguage, "Notes")</th>
                    <th scope="col" data-column="actions" class="flex-grow-0 flex-shrink-0 text-truncate hideOnPrint gb-col-actions"><span class="visually-hidden">@translator.Translate(userLanguage, "Actions")</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (ReminderRecordViewModel reminderRecord in Model)
                {
                    dueItems.TryGetValue(reminderRecord.Id, out var due);
                    var statusClass = due != null ? GloveboxFormat.StatusClass(due) : GloveboxFormat.StatusClass(reminderRecord.Urgency);
                    var statusLabel = due != null ? GloveboxFormat.StatusLabel(due) : GloveboxFormat.StatusLabel(reminderRecord.Urgency);
                    <tr class="d-flex user-select-none" style="cursor:pointer;" onmouseup="stopEvent()" ontouchstart="detectRowLongTouch(this)" ontouchend="detectRowTouchEndPremature(this)" data-rowId="@reminderRecord.Id" data-urgency="@reminderRecord.Urgency" oncontextmenu="showTableContextMenu(this)" onmousemove="rangeMouseMove(this)" onclick="handleTableRowClick(this, showEditReminderRecordModal,@reminderRecord.Id)" data-tags='@string.Join(" ", reminderRecord.Tags)'>
                        <td data-label="@translator.Translate(userLanguage, "Status")" class="col-2 flex-grow-1 flex-shrink-1" data-column="urgency">
                            <span class="gb-pill gb-pill--@statusClass">@translator.Translate(userLanguage, statusLabel)</span>
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Reminder")" data-column="description" class="col-3 flex-grow-1 flex-shrink-1 text-truncate">
                            @reminderRecord.Description
                            @if (reminderRecord.IsRecurring)
                            {
                                <i class="bi bi-arrow-repeat ms-1 text-body-secondary" title="@translator.Translate(userLanguage, "Recurring")"></i>
                            }
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Due")" class="col-3 flex-grow-1 flex-shrink-1" data-column="metric" data-record-type="cost">
                            @if (due != null)
                            {
                                <span class="gb-rem-due">
                                    <span>@GloveboxFormat.DueHeadline(due, unit)</span>
                                    <small>@GloveboxFormat.DueTarget(due, unit)</small>
                                </span>
                            }
                            else if (reminderRecord.Metric == ReminderMetric.Date)
                            {
                                @reminderRecord.Date.ToShortDateString()
                            }
                            else
                            {
                                @reminderRecord.Mileage
                            }
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Date")" class="col-2 text-truncate flex-grow-1 flex-shrink-1" style="display:none;" data-column="date">
                            @(reminderRecord.UserMetric == ReminderMetric.Both || reminderRecord.UserMetric == ReminderMetric.Date ? reminderRecord.Date.ToShortDateString() : "---")
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Odometer")" class="col-2 text-truncate flex-grow-1 flex-shrink-1" style="display:none;" data-column="odometer">
                            @(reminderRecord.UserMetric == ReminderMetric.Both || reminderRecord.UserMetric == ReminderMetric.Odometer ? reminderRecord.Mileage.ToString("N0") : "---")
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Due days")" class="col-1 text-truncate flex-grow-1 flex-shrink-1" style="display:none;" data-column="duedays">
                            @(reminderRecord.UserMetric == ReminderMetric.Both || reminderRecord.UserMetric == ReminderMetric.Date ? reminderRecord.DueDays : "---")
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Due distance")" class="col-1 text-truncate flex-grow-1 flex-shrink-1" style="display:none;" data-column="duedistance">
                            @(reminderRecord.UserMetric == ReminderMetric.Both || reminderRecord.UserMetric == ReminderMetric.Odometer ? reminderRecord.DueMileage.ToString("N0") : "---")
                        </td>
                        <td data-label="@translator.Translate(userLanguage, "Notes")" data-column="notes" class="flex-grow-1 flex-shrink-1 col-2 @noteColumnStyle">@StaticHelper.TruncateStrings(reminderRecord.Notes, noteColumnLength)</td>
                        <td data-label="" class="flex-grow-0 flex-shrink-0 hideOnPrint gb-col-actions" data-column="actions">
                            <span class="gb-rem-actions">
                                @if (hasRefresh && (reminderRecord.Urgency == ReminderUrgency.VeryUrgent || reminderRecord.Urgency == ReminderUrgency.PastDue) && reminderRecord.IsRecurring)
                                {
                                    <button type="button" class="btn btn-secondary btn-sm" onclick="markDoneReminderRecord(@reminderRecord.Id, this)" title="@translator.Translate(userLanguage, "Mark done and roll forward")"><i class="bi bi-check2"></i><span class="gb-hide-sm">@translator.Translate(userLanguage, "Done")</span></button>
                                }
                                <button type="button" class="btn btn-ghost btn-icon btn-sm" onclick="deleteReminderRecord(@reminderRecord.Id, this)" title="@translator.Translate(userLanguage, "Delete")" aria-label="@translator.Translate(userLanguage, "Delete")"><i class="bi bi-trash"></i></button>
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
            <tfoot>
                <tr class="d-flex">
                    <td class="col-12 showOnPrint lubelogger-report-banner">
                        @StaticHelper.ReportNote
                    </td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>
</div>
<div class="modal fade" data-bs-focus="false" id="planRecordModal" tabindex="-1" role="dialog" aria-hidden="true" @StaticHelper.GetStaticModalAttribute(userConfig.EnablePersistentDialog)>
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="planRecordModalContent">
        </div>
    </div>
</div>

<ul class="table-context-menu dropdown-menu" style="display:none;">
    <li><a class="context-menu-multiple context-menu-select-all dropdown-item" href="#" onclick="selectAllRows()"><i class="bi bi-check-square"></i><span>@translator.Translate(userLanguage, "Select all")</span></a></li>
    <li><a class="context-menu-multiple context-menu-deselect-all dropdown-item" href="#" onclick="clearSelectedRows()"><i class="bi bi-x-square"></i><span>@translator.Translate(userLanguage, "Deselect all")</span></a></li>
    <li><hr class="context-menu-multiple dropdown-divider"></li>
    <li><a class="dropdown-item" href="#" onclick="duplicateRecords(selectedRow, 'ReminderRecord')"><i class="bi bi-copy"></i><span>@translator.Translate(userLanguage, "Duplicate")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="duplicateRecordsToOtherVehicles(selectedRow, 'ReminderRecord')"><i class="bi bi-copy"></i><span>@translator.Translate(userLanguage, "Duplicate to vehicle")</span></a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item" href="#" onclick="printTabStickers(selectedRow, 'ReminderRecord')"><i class="bi bi-printer"></i><span>@translator.Translate(userLanguage, "Print sticker")</span></a></li>
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item text-danger" href="#" onclick="deleteRecords(selectedRow, 'ReminderRecord')"><i class="bi bi-trash"></i><span>@translator.Translate(userLanguage, "Delete")</span></a></li>
</ul>

@if (userColumnPreferences.Any())
{
    @await Html.PartialAsync("_UserColumnPreferences", userColumnPreferences)
}

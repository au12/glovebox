@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    var metricOptions = new List<(ImportMode Mode, string Id, int Value, string Label)>
    {
        (ImportMode.OdometerRecord, "odometerExpenseCheck", 6, "Distance"),
        (ImportMode.ServiceRecord, "serviceExpenseCheck", 1, "Service"),
        (ImportMode.RepairRecord, "repairExpenseCheck", 2, "Repairs"),
        (ImportMode.UpgradeRecord, "upgradeExpenseCheck", 3, "Upgrades"),
        (ImportMode.GasRecord, "gasExpenseCheck", 4, "Fuel"),
        (ImportMode.TaxRecord, "taxExpenseCheck", 5, "Taxes")
    };
}
@model ReportViewModel
<script>
    var availableMetrics = [];
    @foreach (ImportMode importMode in Model.AvailableMetrics)
    {
        @:availableMetrics.push('@importMode');
    }
</script>
<div class="vehicleTabPane gb-charts">
    <div class="gb-charts-toolbar hideOnPrint">
        <div class="gb-report-summary" id="reportHeaderContent">
            @await Html.PartialAsync("Report/_ReportHeader", Model.ReportHeaderForVehicle)
        </div>
        <div class="gb-charts-period">
            <label class="visually-hidden" for="yearOption">@translator.Translate(userLanguage, "Period")</label>
            <select class="form-select" id="yearOption" onchange="yearUpdated()">
                <option value="0">@translator.Translate(userLanguage, "All time")</option>
                @foreach (int year in Model.Years)
                {
                    <option value="@year">@year</option>
                }
            </select>
        </div>
    </div>
    <div class="gb-charts-grid hideOnPrint">
        <section class="gb-panel gb-chart-card gb-chart-wide">
            <header>
                <h3>
                    <span class="gb-cost-only">@translator.Translate(userLanguage, "Spending and distance by month")</span>
                    <span class="gb-cost-hidden-only">@translator.Translate(userLanguage, "Distance by month")</span>
                </h3>
                <div class="dropdown gb-cost-only">
                    <button class="btn btn-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false" @(Model.AvailableMetrics.Any() ? "" : "disabled")>
                        @translator.Translate(userLanguage, "Include")
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                        <li class="dropdown-item">
                            <div class="form-check m-0">
                                <input class="form-check-input" onChange="updateCheckAll()" type="checkbox" id="selectAllExpenseCheck" value="0" checked>
                                <label class="form-check-label stretched-link" for="selectAllExpenseCheck">@translator.Translate(userLanguage, "Everything")</label>
                            </div>
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        @foreach (var metric in metricOptions)
                        {
                            <li class="dropdown-item @(Model.AvailableMetrics.Contains(metric.Mode) ? "" : "d-none")">
                                <div class="form-check m-0">
                                    <input class="form-check-input reportCheckBox" onChange="updateCheck()" type="checkbox" id="@metric.Id" value="@metric.Value" checked>
                                    <label class="form-check-label stretched-link" for="@metric.Id">@translator.Translate(userLanguage, metric.Label)</label>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </header>
            <div class="chartContainer" id="gasCostByMonthReportContent">
                @await Html.PartialAsync("Report/_GasCostByMonthReport", Model.CostForVehicleByMonth)
            </div>
        </section>
        <section class="gb-panel gb-chart-card">
            <header>
                <h3>@translator.Translate(userLanguage, "Reminders")</h3>
                <select class="form-select form-select-sm" onchange="updateReminderPie()" id="reminderOption" aria-label="@translator.Translate(userLanguage, "As of")">
                    <option value="0">@translator.Translate(userLanguage, "Today")</option>
                    <option value="30">@translator.Translate(userLanguage, "In 30 days")</option>
                    <option value="60">@translator.Translate(userLanguage, "In 60 days")</option>
                    <option value="90">@translator.Translate(userLanguage, "In 90 days")</option>
                </select>
            </header>
            <div class="chartContainer" id="reminderMakeUpReportContent">
                @await Html.PartialAsync("Report/_ReminderMakeUpReport", Model.ReminderMakeUpForVehicle)
            </div>
        </section>
        <section class="gb-panel gb-chart-card gb-chart-wide">
            <header>
                <h3>@translator.Translate(userLanguage, "Fuel economy by month")</h3>
            </header>
            <div class="chartContainer" id="monthFuelMileageReportContent">
                @await Html.PartialAsync("Report/_MPGByMonthReport", Model.FuelMileageForVehicleByMonth)
            </div>
        </section>
        <section class="gb-panel gb-chart-card gb-cost-only">
            <header>
                <h3>@translator.Translate(userLanguage, "Where the money goes")</h3>
            </header>
            <div class="chartContainer" id="costMakeUpReportContent">
                @await Html.PartialAsync("Report/_CostMakeUpReport", Model.CostMakeUpForVehicle)
            </div>
        </section>
    </div>
    <div class="gb-report-actions hideOnPrint">
        <button type="button" onclick="generateVehicleHistoryReport()" class="btn btn-secondary"><i class="bi bi-file-earmark-text"></i>@translator.Translate(userLanguage, "Maintenance report")</button>
        <button type="button" onclick="exportAttachments()" class="btn btn-secondary"><i class="bi bi-file-earmark-zip"></i>@translator.Translate(userLanguage, "Export attachments")</button>
        @if (Model.HasVehicleImageMap)
        {
            <button type="button" onclick="loadVehicleImageMap()" class="btn btn-secondary"><i class="bi bi-map"></i>@translator.Translate(userLanguage, "Vehicle map")</button>
        }
        @if (Model.CustomWidgetsConfigured)
        {
            <button type="button" onclick="showCustomWidgets()" class="btn btn-secondary"><i class="bi bi-grid-1x2"></i>@translator.Translate(userLanguage, "Additional widgets")</button>
        }
    </div>
</div>
<div class="modal fade" data-bs-focus="false" id="vehicleDataTableModal" tabindex="-1" role="dialog" aria-hidden="true" @StaticHelper.GetStaticModalAttribute(userConfig.EnablePersistentDialog)>
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content" id="vehicleDataTableModalContent">
        </div>
    </div>
</div>
@if (Model.CustomWidgetsConfigured)
{
    <div class="modal fade" data-bs-focus="false" id="vehicleCustomWidgetsModal" tabindex="-1" role="dialog" aria-hidden="true" @StaticHelper.GetStaticModalAttribute(userConfig.EnablePersistentDialog)>
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content" id="vehicleCustomWidgetsModalContent">
            </div>
        </div>
    </div>
    <script>loadCustomWidgets()</script>
}
<script>
    getSelectedMetrics();
</script>

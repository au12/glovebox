@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
    var openRegistrationEnabled = config.GetServerOpenRegistration();
}
@model OpenIDRegistrationModel
@{
    ViewData["Title"] = "Create an account";
    ViewData["FullBleed"] = true;
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.AssetVersion"></script>
}
@if (Model.RegistrationDisabled)
{
    <div class="gb-auth">
        <div class="gb-auth-card">
            <partial name="_Brand" />
            <h1>@translator.Translate(userLanguage, "Access denied")</h1>
            <p class="gb-auth-sub">@translator.Translate(userLanguage, "This account isn't allowed to register here. Ask your administrator for access.")</p>
            <div class="gb-auth-links">
                <a href="/Login/Index"><i class="bi bi-arrow-left me-1"></i>@translator.Translate(userLanguage, "Back to sign in")</a>
                @if (!string.IsNullOrWhiteSpace(Model.LogOutUrl))
                {
                    <a href="@Model.LogOutUrl">@translator.Translate(userLanguage, "Sign out")</a>
                }
            </div>
        </div>
    </div>
}
else
{
    <div class="gb-auth">
        <form class="gb-auth-card" onsubmit="performOpenIdRegistration(); return false;">
            <partial name="_Brand" />
            <h1>@translator.Translate(userLanguage, "Create an account")</h1>
            <p class="gb-auth-sub">@translator.Translate(userLanguage, "Choose the username you'll use in Glovebox.")</p>
            <label for="inputToken" class="@(string.IsNullOrWhiteSpace(Model.Token) ? "" : "d-none")">@translator.Translate(userLanguage, "Token")</label>
            @if (openRegistrationEnabled && string.IsNullOrWhiteSpace(Model.Token))
            {
                <div class="input-group input-group-lg">
                    <input type="text" id="inputToken" class="form-control" autocomplete="one-time-code" spellcheck="false">
                    <button type="button" class="btn btn-secondary" onclick="sendOpenIdRegistrationToken()"><i class="bi bi-send"></i>@translator.Translate(userLanguage, "Send")</button>
                </div>
            }
            else
            {
                <input type="text" id="inputToken" class="form-control form-control-lg @(string.IsNullOrWhiteSpace(Model.Token) ? "" : "d-none")" value="@Model.Token" spellcheck="false">
            }
            <label for="inputUserName">@translator.Translate(userLanguage, "Username")</label>
            <input type="text" id="inputUserName" class="form-control form-control-lg" value="@Model.EmailAddress" autocomplete="username" autocapitalize="none" spellcheck="false">
            <button type="submit" class="btn btn-primary btn-lg mt-4">@translator.Translate(userLanguage, "Create account")</button>
            <div class="gb-auth-links">
                <a href="/Login/Index"><i class="bi bi-arrow-left me-1"></i>@translator.Translate(userLanguage, "Back to sign in")</a>
            </div>
        </form>
    </div>
    <script>
        function performOpenIdRegistration() {
            var token = $("#inputToken").val();
            var userName = $("#inputUserName").val();
            var userEmail = decodeHTMLEntities('@Model.EmailAddress');
            $.post('/Login/RegisterOpenIdUser', { userName: userName, token: token, emailAddress: userEmail }, function (data) {
                if (data.success) {
                    successToast(data.message);
                    setTimeout(function () { window.location.href = '/Home' }, 500);
                } else {
                    errorToast(data.message);
                }
            });
        }
        function sendOpenIdRegistrationToken(){
            var userEmail = decodeHTMLEntities('@Model.EmailAddress');
            $.post('/Login/SendRegistrationToken', { emailAddress: userEmail }, function (data) {
                if (data.success) {
                    successToast(data.message);
                } else {
                    errorToast(data.message);
                }
            });
        }
    </script>
}
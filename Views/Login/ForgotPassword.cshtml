@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
    ViewData["Title"] = "Forgot password";
    ViewData["FullBleed"] = true;
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.AssetVersion"></script>
}
<div class="gb-auth">
    <form class="gb-auth-card" onsubmit="requestPasswordReset(); return false;">
        <partial name="_Brand" />
        <h1>@translator.Translate(userLanguage, "Reset your password")</h1>
        <p class="gb-auth-sub">@translator.Translate(userLanguage, "We'll email a reset token to the address on your account.")</p>
        <label for="inputUserName">@translator.Translate(userLanguage, "Username")</label>
        <input type="text" id="inputUserName" class="form-control form-control-lg" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
        <button type="submit" class="btn btn-primary btn-lg mt-4">@translator.Translate(userLanguage, "Send reset token")</button>
        <div class="gb-auth-links">
            <a href="/Login/Index"><i class="bi bi-arrow-left me-1"></i>@translator.Translate(userLanguage, "Back to sign in")</a>
            <a href="/Login/ResetPassword">@translator.Translate(userLanguage, "I have a token")</a>
        </div>
    </form>
</div>

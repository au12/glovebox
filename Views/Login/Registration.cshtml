@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@{
    var userLanguage = config.GetServerLanguage();
    var openRegistrationEnabled = config.GetServerOpenRegistration();
}
@model LoginModel
@{
    ViewData["Title"] = "Create an account";
    ViewData["FullBleed"] = true;
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.AssetVersion"></script>
}
<div class="gb-auth">
    <form class="gb-auth-card" onsubmit="performRegistration(); return false;">
        <partial name="_Brand" />
        <h1>@translator.Translate(userLanguage, "Create an account")</h1>
        <p class="gb-auth-sub">@translator.Translate(userLanguage, openRegistrationEnabled ? "Enter your email and tap send to get a registration token." : "You'll need the registration token from your administrator.")</p>
        <label for="inputEmail">@translator.Translate(userLanguage, "Email address")</label>
        <input type="email" id="inputEmail" class="form-control form-control-lg" value="@Model.EmailAddress" autocomplete="email">
        <label for="inputToken">@translator.Translate(userLanguage, "Token")</label>
        @if (openRegistrationEnabled)
        {
            <div class="input-group input-group-lg">
                <input type="text" id="inputToken" class="form-control" value="@Model.Token" autocomplete="one-time-code" spellcheck="false">
                <button type="button" class="btn btn-secondary" onclick="sendRegistrationToken()"><i class="bi bi-send"></i>@translator.Translate(userLanguage, "Send")</button>
            </div>
        }
        else
        {
            <input type="text" id="inputToken" class="form-control form-control-lg" value="@Model.Token" autocomplete="one-time-code" spellcheck="false">
        }
        <label for="inputUserName">@translator.Translate(userLanguage, "Username")</label>
        <input type="text" id="inputUserName" class="form-control form-control-lg" autocomplete="username" autocapitalize="none" spellcheck="false">
        <label for="inputUserPassword">@translator.Translate(userLanguage, "Password")</label>
        <div class="input-group input-group-lg">
            <input type="password" id="inputUserPassword" class="form-control" autocomplete="new-password">
            <button type="button" class="btn btn-secondary password-visible-button" onclick="togglePasswordVisibility(this)" aria-label="@translator.Translate(userLanguage, "Show password")"><i class="bi bi-eye"></i></button>
        </div>
        <button type="submit" class="btn btn-primary btn-lg mt-4">@translator.Translate(userLanguage, "Create account")</button>
        <div class="gb-auth-links">
            <a href="/Login/Index"><i class="bi bi-arrow-left me-1"></i>@translator.Translate(userLanguage, "Back to sign in")</a>
        </div>
    </form>
</div>

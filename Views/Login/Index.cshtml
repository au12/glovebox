@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model string
@{
    var userLanguage = config.GetServerLanguage();
    var registrationDisabled = config.GetServerDisabledRegistration();
    var openIdConfigName = config.GetOpenIDConfig().Name;
    var motd = config.GetMOTD();
    ViewData["Title"] = "Sign in";
    ViewData["FullBleed"] = true;
}
@section Scripts {
    <script src="~/js/login.js?v=@StaticHelper.AssetVersion"></script>
}
<div class="gb-auth">
    <form class="gb-auth-card" onsubmit="performLogin(); return false;">
        <partial name="_Brand" />
        <h1>@translator.Translate(userLanguage, "Sign in")</h1>
        <p class="gb-auth-sub">@(string.IsNullOrWhiteSpace(motd) ? translator.Translate(userLanguage, "Your vehicles, their service history and what's due next.") : motd)</p>
        <label for="inputUserName">@translator.Translate(userLanguage, "Username")</label>
        <input type="text" id="inputUserName" class="form-control form-control-lg" autocomplete="username" autocapitalize="none" spellcheck="false" autofocus>
        <label for="inputUserPassword">@translator.Translate(userLanguage, "Password")</label>
        <div class="input-group input-group-lg">
            <input type="password" id="inputUserPassword" class="form-control" autocomplete="current-password">
            <button type="button" class="btn btn-secondary password-visible-button" onclick="togglePasswordVisibility(this)" aria-label="@translator.Translate(userLanguage, "Show password")"><i class="bi bi-eye"></i></button>
        </div>
        <div class="form-check form-switch mt-3">
            <input class="form-check-input" type="checkbox" role="switch" id="inputPersistent">
            <label class="form-check-label" for="inputPersistent">@translator.Translate(userLanguage, "Keep me signed in")</label>
        </div>
        <button type="submit" class="btn btn-primary btn-lg mt-4">@translator.Translate(userLanguage, "Sign in")</button>
        @if (!string.IsNullOrWhiteSpace(openIdConfigName))
        {
            <button type="button" class="btn btn-secondary btn-lg mt-2" onclick="remoteLogin()"><i class="bi bi-shield-lock"></i>@($"{translator.Translate(userLanguage, "Sign in with")} {openIdConfigName}")</button>
        }
        <div class="gb-auth-links">
            <a href="/Login/ForgotPassword">@translator.Translate(userLanguage, "Forgot password?")</a>
            @if (!registrationDisabled)
            {
                <a href="/Login/Registration">@translator.Translate(userLanguage, "Create an account")</a>
            }
        </div>
    </form>
</div>
<script>
    function getRedirectURL() {
        return { url: decodeHTMLEntities('@Model') };
    }
    checkPersistLoginState();
</script>

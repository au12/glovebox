@using CarCareTracker.Helper
@inject IConfigHelper config
@inject ITranslationHelper translator
@model List<VehicleViewModel>
@{
    var userConfig = config.GetUserConfig(User);
    var userLanguage = userConfig.UserLanguage;
    var hideCosts = userConfig.HideCostTracking;
    var vehicles = Model.Where(x => !(userConfig.HideSoldVehicles && !string.IsNullOrWhiteSpace(x.SoldDate)))
        .OrderBy(x => string.IsNullOrWhiteSpace(x.SoldDate) ? 0 : 1)
        .ToList();
    var activeVehicles = vehicles.Where(x => string.IsNullOrWhiteSpace(x.SoldDate)).ToList();
    var recordTags = vehicles.SelectMany(x => x.Tags).Distinct().ToList();
    var overdue = activeVehicles.Sum(x => x.OverdueCount);
    var urgent = activeVehicles.Sum(x => x.UrgentCount);
    var dueSoon = activeVehicles.Sum(x => x.DueSoonCount);
    var headsUp = activeVehicles.Sum(x => x.HeadsUpCount);
    var attention = activeVehicles
        .SelectMany(v => v.DueItems.Where(d => d.Urgency != ReminderUrgency.NotUrgent || d.InHeadsUpWindow).Select(d => new { Vehicle = v, Item = d }))
        .OrderBy(x => x.Item.SortKey)
        .Take(6)
        .ToList();
}
<div id="garageContainer" class="gb-page">
    <div class="gb-garage-head">
        <div>
            <h1>@translator.Translate(userLanguage, "Garage")</h1>
            <div class="gb-status-line">
                @if (overdue > 0)
                {
                    <span><span class="gb-dot gb-dot--overdue"></span>@overdue @translator.Translate(userLanguage, "overdue")</span>
                }
                @if (urgent > 0)
                {
                    <span><span class="gb-dot gb-dot--urgent"></span>@urgent @translator.Translate(userLanguage, "urgent")</span>
                }
                @if (dueSoon > 0)
                {
                    <span><span class="gb-dot gb-dot--soon"></span>@dueSoon @translator.Translate(userLanguage, "due soon")</span>
                }
                @if (headsUp > 0)
                {
                    <span><span class="gb-dot gb-dot--info"></span>@headsUp @translator.Translate(userLanguage, "coming up")</span>
                }
                @if (overdue + urgent + dueSoon + headsUp == 0 && activeVehicles.Any())
                {
                    <span><span class="gb-dot gb-dot--ok"></span>@translator.Translate(userLanguage, "Nothing needs attention right now")</span>
                }
                @if (vehicles.Any())
                {
                    <span class="text-body-secondary">@vehicles.Count @translator.Translate(userLanguage, vehicles.Count == 1 ? "vehicle" : "vehicles")</span>
                }
            </div>
        </div>
        @if (vehicles.Any())
        {
            <button type="button" class="btn btn-primary" onclick="showAddVehicleModal()"><i class="bi bi-plus-lg"></i>@translator.Translate(userLanguage, "Add vehicle")</button>
        }
    </div>

    @if (attention.Any())
    {
        <section class="gb-attention" aria-label="@translator.Translate(userLanguage, "Needs attention")">
            <div class="gb-attention-head">
                <h2>@translator.Translate(userLanguage, "Needs attention")</h2>
            </div>
            @foreach (var entry in attention)
            {
                var statusClass = GloveboxFormat.StatusClass(entry.Item);
                <a class="gb-attention-row" href="/Vehicle/Index?vehicleId=@entry.Vehicle.Id&tab=report">
                    <span class="gb-dot gb-dot--@statusClass" title="@GloveboxFormat.StatusLabel(entry.Item)"></span>
                    @if (GloveboxFormat.HasPhoto(entry.Vehicle.ImageLocation))
                    {
                        <img src="@entry.Vehicle.ImageLocation" alt="" loading="lazy" />
                    }
                    else
                    {
                        <span class="gb-photo-empty gb-photo-empty--thumb" aria-hidden="true"><i class="bi bi-car-front"></i></span>
                    }
                    <span class="gb-att-main">
                        <strong>@entry.Item.Description</strong>
                        <small>@($"{entry.Vehicle.Year} {entry.Vehicle.Make} {entry.Vehicle.Model}")</small>
                    </span>
                    <span class="gb-att-due text-@(statusClass == "overdue" ? "danger" : statusClass == "ok" ? "success" : statusClass == "info" ? "info" : "warning")">@GloveboxFormat.DueHeadline(entry.Item, entry.Vehicle.DistanceUnit)</span>
                </a>
            }
        </section>
    }

    @if (recordTags.Any())
    {
        <div class="gb-filterbar">
            @foreach (string recordTag in recordTags)
            {
                <span onclick="filterGarage(this)" class="user-select-none rounded-pill badge bg-secondary tagfilter" style="cursor:pointer;">@recordTag</span>
            }
        </div>
    }

    @if (vehicles.Any())
    {
        <div class="gb-garage-grid vehiclesContainer">
            @foreach (VehicleViewModel vehicle in vehicles)
            {
                var isSold = !string.IsNullOrWhiteSpace(vehicle.SoldDate);
                var identifier = StaticHelper.GetVehicleIdentifier(vehicle);
                <div class="garage-item user-select-none" onclick="handleGarageItemClick(this, @vehicle.Id)" oncontextmenu="showGarageContextMenu(this)" data-tags='@string.Join(" ", vehicle.Tags)' data-rowId="@vehicle.Id" id="gridVehicle_@vehicle.Id" data-extra-fields="@await Html.PartialAsync("_VehicleExtraFields", vehicle.ExtraFields)" onmousemove="garageRangeMouseMove(this)" ontouchstart="detectGarageLongTouch(this)" ontouchend="detectGarageTouchEndPremature(this)">
                    <article class="gb-vcard @(isSold ? "sold" : "")">
                        <div class="gb-vcard-media">
                            @if (GloveboxFormat.HasPhoto(vehicle.ImageLocation))
                            {
                                <img src="@vehicle.ImageLocation" alt="" loading="lazy" />
                            }
                            else
                            {
                                <span class="gb-photo-empty" aria-hidden="true"><i class="bi bi-car-front"></i></span>
                            }
                            <div class="gb-vcard-flag">
                                @if (isSold)
                                {
                                    <span class="gb-pill gb-pill--info">@($"{translator.Translate(userLanguage, "Sold")} {vehicle.SoldDate}")</span>
                                }
                                else if (vehicle.OverdueCount > 0)
                                {
                                    <span class="gb-pill gb-pill--overdue">@vehicle.OverdueCount @translator.Translate(userLanguage, "overdue")</span>
                                }
                                else if (vehicle.UrgentCount > 0)
                                {
                                    <span class="gb-pill gb-pill--urgent">@translator.Translate(userLanguage, "Urgent")</span>
                                }
                                else if (vehicle.DueSoonCount > 0)
                                {
                                    <span class="gb-pill gb-pill--soon">@translator.Translate(userLanguage, "Due soon")</span>
                                }
                                else if (vehicle.HeadsUpCount > 0)
                                {
                                    <span class="gb-pill gb-pill--info">@translator.Translate(userLanguage, "Coming up")</span>
                                }
                                else if (vehicle.DueItems.Any())
                                {
                                    <span class="gb-pill gb-pill--ok">@translator.Translate(userLanguage, "All good")</span>
                                }
                            </div>
                            @if (!string.IsNullOrWhiteSpace(identifier))
                            {
                                <span class="gb-vcard-plate">@identifier</span>
                            }
                            @if (vehicle.LastReportedMileage > 0)
                            {
                                <div class="gb-vcard-odo">
                                    @await Html.PartialAsync("_Odometer", new OdometerViewModel { Value = vehicle.LastReportedMileage, Unit = vehicle.DistanceUnit, Size = "sm" })
                                </div>
                            }
                        </div>
                        <div class="gb-vcard-body">
                            <div class="gb-vcard-title">
                                <small class="garage-item-attribute garage-item-year" data-unit="@vehicle.Year">@vehicle.Year</small>
                                <strong class="garage-item-attribute">@($"{vehicle.Make} {vehicle.Model}")</strong>
                            </div>
                            <div class="gb-vcard-next">
                                @if (vehicle.DueItems.Any())
                                {
                                    @foreach (var item in vehicle.DueItems.Take(2))
                                    {
                                        <div class="gb-vcard-next-row">
                                            <span class="gb-dot gb-dot--@GloveboxFormat.StatusClass(item)" title="@GloveboxFormat.StatusLabel(item)"></span>
                                            <span class="gb-next-desc">@item.Description</span>
                                            <span class="gb-next-due">@GloveboxFormat.DueShort(item, vehicle.DistanceUnit)</span>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="gb-vcard-empty">@translator.Translate(userLanguage, "No reminders yet")</span>
                                }
                            </div>
                            @if (!hideCosts && (vehicle.DashboardMetrics.Contains(DashboardMetric.TotalCost) || vehicle.DashboardMetrics.Contains(DashboardMetric.CostPerMile)))
                            {
                                <div class="gb-vcard-metrics gb-cost">
                                    @if (vehicle.DashboardMetrics.Contains(DashboardMetric.TotalCost) && vehicle.TotalCost != default)
                                    {
                                        <span><i class="bi bi-cash-stack"></i>@vehicle.TotalCost.ToString("C0") @translator.Translate(userLanguage, "total")</span>
                                    }
                                    @if (vehicle.DashboardMetrics.Contains(DashboardMetric.CostPerMile) && vehicle.CostPerMile != default)
                                    {
                                        <span><i class="bi bi-graph-up"></i>@($"{vehicle.CostPerMile.ToString("C2")}/{vehicle.DistanceUnit}")</span>
                                    }
                                </div>
                            }
                        </div>
                    </article>
                </div>
            }
            <div class="garage-item-add user-select-none">
                <button type="button" class="gb-vcard-add w-100 h-100" onclick="showAddVehicleModal()"><i class="bi bi-plus-lg"></i>@translator.Translate(userLanguage, "Add vehicle")</button>
            </div>
        </div>
    }
    else
    {
        <div class="gb-empty">
            <partial name="_BrandMark" />
            <h2>@translator.Translate(userLanguage, "Your garage is empty")</h2>
            <p>@translator.Translate(userLanguage, "Add a vehicle to start logging service, fuel and reminders.")</p>
            <button type="button" class="btn btn-primary btn-lg" onclick="showAddVehicleModal()"><i class="bi bi-plus-lg"></i>@translator.Translate(userLanguage, "Add your first vehicle")</button>
        </div>
    }
</div>
<ul class="garage-context-menu dropdown-menu" style="display:none;">
    <li><a class="context-menu-multiple context-menu-select-all dropdown-item" href="#" onclick="selectAllVehicles()"><i class="bi bi-check-square"></i><span>@translator.Translate(userLanguage, "Select all")</span></a></li>
    <li><a class="context-menu-multiple context-menu-deselect-all dropdown-item" href="#" onclick="clearSelectedVehicles()"><i class="bi bi-x-square"></i><span>@translator.Translate(userLanguage, "Deselect all")</span></a></li>
    <li><hr class="context-menu-multiple dropdown-divider"></li>
    <li><a class="context-menu-multiple dropdown-item" href="#" onclick="sortGarage()"><i class="garage-sort-icon bi bi-arrow-down-up"></i><span>@translator.Translate(userLanguage, "Sort by year")</span></a></li>
    <li><a class="context-menu-extra-field dropdown-item" href="#" onclick="showVehicleExtraFields(selectedVehicles)"><i class="bi bi-list-ul"></i><span>@translator.Translate(userLanguage, "Extra fields")</span></a></li>
    <li><a class="dropdown-item" href="#" onclick="manageCollaborators(selectedVehicles)"><i class="bi bi-people"></i><span>@translator.Translate(userLanguage, "Manage collaborators")</span></a></li>
    <li><hr class="context-menu-active-single dropdown-divider"></li>
    <li><h6 class="context-menu-active-single dropdown-header">@translator.Translate(userLanguage, "Go to")</h6></li>
    <li><a class="context-menu-active-single dropdown-item" href="#" onclick="viewVehicleWithTab(selectedVehicles, 'report')"><i class="bi bi-speedometer2"></i><span>@translator.Translate(userLanguage, "Overview")</span></a></li>
    @foreach (ImportMode importMode in new[] { ImportMode.ReminderRecord, ImportMode.ServiceRecord, ImportMode.RepairRecord, ImportMode.UpgradeRecord, ImportMode.GasRecord, ImportMode.OdometerRecord, ImportMode.NoteRecord, ImportMode.TaxRecord, ImportMode.PlanRecord, ImportMode.InspectionRecord, ImportMode.EquipmentRecord, ImportMode.SupplyRecord })
    {
        if (userConfig.VisibleTabs.Contains(importMode))
        {
            <li><a class="context-menu-active-single dropdown-item" href="#" onclick="viewVehicleWithTab(selectedVehicles, '@GloveboxFormat.TabId(importMode)')"><i class="bi @GloveboxFormat.RecordIcon(importMode)"></i><span>@translator.Translate(userLanguage, StaticHelper.GetImportModeName(importMode, true))</span></a></li>
        }
    }
    <li><hr class="dropdown-divider"></li>
    <li><a class="dropdown-item text-danger" href="#" onclick="deleteVehicles(selectedVehicles)"><i class="bi bi-trash"></i><span>@translator.Translate(userLanguage, "Delete")</span></a></li>
</ul>

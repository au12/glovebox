@using CarCareTracker.Helper
@model SettingsViewModel
@inject ITranslationHelper translator
@inject IConfigHelper config
@{
    var userLanguage = Model.UserConfig.UserLanguage;
    var cfg = Model.UserConfig;
    var ntfy = cfg.Ntfy ?? new NtfyConfig();
    var isRoot = User.IsInRole(nameof(UserData.IsRootUser));
    var distanceUnit = cfg.UseMPG ? "mi" : "km";
    var colorMode = cfg.UseSystemColorMode ? "system" : (cfg.UseDarkMode ? "dark" : "light");
    var sections = new List<(ImportMode Mode, string Icon, string Label, string Help)>
    {
        (ImportMode.ReminderRecord, "bi-bell", "Reminders", "Upcoming maintenance by date or mileage"),
        (ImportMode.ServiceRecord, "bi-wrench-adjustable", "Service records", "Routine maintenance you've done"),
        (ImportMode.RepairRecord, "bi-tools", "Repairs", "Fixes and breakdowns"),
        (ImportMode.UpgradeRecord, "bi-stars", "Upgrades", "Modifications and improvements"),
        (ImportMode.GasRecord, "bi-fuel-pump", "Fuel", "Fill-ups and fuel economy"),
        (ImportMode.OdometerRecord, "bi-speedometer", "Odometer", "Mileage readings"),
        (ImportMode.NoteRecord, "bi-journal-text", "Notes", "Specs, part numbers, anything else"),
        (ImportMode.TaxRecord, "bi-receipt", "Taxes & fees", "Registration, insurance, tolls"),
        (ImportMode.PlanRecord, "bi-kanban", "Planner", "Plan upcoming work as a board"),
        (ImportMode.InspectionRecord, "bi-clipboard-check", "Inspections", "Checklists and inspection results"),
        (ImportMode.EquipmentRecord, "bi-disc", "Equipment", "Tires, wheels and swappable parts"),
        (ImportMode.SupplyRecord, "bi-box-seam", "Supplies", "Parts and fluids on hand")
    };
}
<div class="gb-page">
    <div class="gb-garage-head" style="margin-bottom:1.25rem;">
        <div>
            <h1>@translator.Translate(userLanguage, "Settings")</h1>
            <div class="gb-status-line"><span>@translator.Translate(userLanguage, "Changes save automatically.")</span></div>
        </div>
    </div>
    <input id="preferredGasUnit" type="hidden" value="@cfg.PreferredGasUnit" />
    <input id="preferredFuelMileageUnit" type="hidden" value="@cfg.PreferredGasMileageUnit" />
    <div class="gb-settings">
        <nav class="gb-settings-nav" aria-label="@translator.Translate(userLanguage, "Settings sections")">
            <button type="button" data-settings-page="appearance"><i class="bi bi-circle-half"></i>@translator.Translate(userLanguage, "Appearance")</button>
            <button type="button" data-settings-page="garage"><i class="bi bi-car-front"></i>@translator.Translate(userLanguage, "Vehicles")</button>
            <button type="button" data-settings-page="notifications"><i class="bi bi-bell"></i>@translator.Translate(userLanguage, "Notifications")</button>
            <button type="button" data-settings-page="units"><i class="bi bi-rulers"></i>@translator.Translate(userLanguage, "Units")</button>
            <button type="button" data-settings-page="costs"><i class="bi bi-cash-stack"></i>@translator.Translate(userLanguage, "Costs")</button>
            <button type="button" data-settings-page="records"><i class="bi bi-list-check"></i>@translator.Translate(userLanguage, "Records")</button>
            <button type="button" data-settings-page="automation"><i class="bi bi-magic"></i>@translator.Translate(userLanguage, "Automation")</button>
            @if (isRoot)
            {
                <button type="button" data-settings-page="admin"><i class="bi bi-shield-lock"></i>@translator.Translate(userLanguage, "Server")</button>
            }
            <button type="button" data-settings-page="about"><i class="bi bi-info-circle"></i>@translator.Translate(userLanguage, "About")</button>
        </nav>

        <div>
            <!-- Appearance -->
            <section class="gb-settings-page" data-settings-section="appearance">
                <header>
                    <h2>@translator.Translate(userLanguage, "Appearance")</h2>
                    <p>@translator.Translate(userLanguage, "How Glovebox looks on this account.")</p>
                </header>
                <div class="gb-group">
                    <div class="gb-row">
                        <div class="gb-row-text"><strong>@translator.Translate(userLanguage, "Color mode")</strong><p>@translator.Translate(userLanguage, "System follows your device's light or dark setting.")</p></div>
                        <div class="gb-row-control">
                            <div class="gb-segmented" role="radiogroup" aria-label="@translator.Translate(userLanguage, "Color mode")">
                                <input type="radio" name="gbColorMode" id="colorModeLight" value="light" @(colorMode == "light" ? "checked" : "") onchange="gbColorModeChanged()"><label for="colorModeLight"><i class="bi bi-sun"></i>@translator.Translate(userLanguage, "Light")</label>
                                <input type="radio" name="gbColorMode" id="colorModeDark" value="dark" @(colorMode == "dark" ? "checked" : "") onchange="gbColorModeChanged()"><label for="colorModeDark"><i class="bi bi-moon-stars"></i>@translator.Translate(userLanguage, "Dark")</label>
                                <input type="radio" name="gbColorMode" id="colorModeSystem" value="system" @(colorMode == "system" ? "checked" : "") onchange="gbColorModeChanged()"><label for="colorModeSystem"><i class="bi bi-circle-half"></i>@translator.Translate(userLanguage, "System")</label>
                            </div>
                        </div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="defaultTheme">@translator.Translate(userLanguage, "Custom theme")</label><p>@translator.Translate(userLanguage, "Optional CSS file layered on top of the Glovebox styles.")</p></div>
                        <div class="gb-row-control">
                            <select class="form-select" onchange="updateSettings(true)" id="defaultTheme">
                                <!option value="" @(string.IsNullOrWhiteSpace(cfg.UserTheme) ? "selected" : "")>@translator.Translate(userLanguage, "None")</!option>
                                @foreach (string uiTheme in Model.UIThemes)
                                {
                                    <!option value="@uiTheme" @(cfg.UserTheme == uiTheme ? "selected" : "")>@uiTheme</!option>
                                }
                            </select>
                            @if (isRoot)
                            {
                                <input onChange="uploadTheme(this)" type="file" accept=".css" class="d-none" id="inputTheme">
                                <button type="button" class="btn btn-secondary btn-icon" onclick="openUploadTheme()" title="@translator.Translate(userLanguage, "Upload theme")" aria-label="@translator.Translate(userLanguage, "Upload theme")"><i class="bi bi-upload"></i></button>
                                <button type="button" class="btn btn-secondary btn-icon" onclick="deleteTheme()" @(string.IsNullOrWhiteSpace(cfg.UserTheme) ? "disabled" : "") title="@translator.Translate(userLanguage, "Delete theme")" aria-label="@translator.Translate(userLanguage, "Delete theme")"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="defaultLanguage">@translator.Translate(userLanguage, "Language")</label></div>
                        <div class="gb-row-control">
                            <select class="form-select" onchange="updateSettings(true)" id="defaultLanguage">
                                @foreach (string uiLanguage in Model.UILanguages)
                                {
                                    <!option value="@uiLanguage" @(cfg.UserLanguage == uiLanguage ? "selected" : "")>@StaticHelper.GetTranslationName(uiLanguage)</!option>
                                }
                            </select>
                            @if (isRoot)
                            {
                                <button type="button" class="btn btn-secondary btn-icon" onclick="showTranslationEditor()" title="@translator.Translate(userLanguage, "Edit translation")" aria-label="@translator.Translate(userLanguage, "Edit translation")"><i class="bi bi-pencil"></i></button>
                                <button type="button" class="btn btn-secondary btn-icon" @(cfg.UserLanguage == "en_US" ? "disabled" : "") onclick="deleteLanguage()" title="@translator.Translate(userLanguage, "Delete translation")" aria-label="@translator.Translate(userLanguage, "Delete translation")"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                </div>
                <div class="gb-group">
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="showVehicleThumbnail">@translator.Translate(userLanguage, "Vehicle photo in the top bar")</label></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" id="showVehicleThumbnail" checked="@cfg.ShowVehicleThumbnail"></div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="enablePersistentDialog">@translator.Translate(userLanguage, "Keep forms open when clicking outside")</label><p>@translator.Translate(userLanguage, "Prevents losing a half-filled form to a stray tap.")</p></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" id="enablePersistentDialog" checked="@cfg.EnablePersistentDialog"></div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="disableAutoZoom">@translator.Translate(userLanguage, "Disable pinch zoom on phones")</label></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" id="disableAutoZoom" checked="@cfg.DisableAutoZoom"></div>
                    </div>
                </div>
            </section>

            <!-- Vehicles -->
            <section class="gb-settings-page" data-settings-section="garage">
                <header>
                    <h2>@translator.Translate(userLanguage, "Vehicles")</h2>
                    <p>@translator.Translate(userLanguage, "Choose which sections each vehicle shows. Hidden sections keep their data.")</p>
                </header>
                <div class="gb-group" id="visibleTabs">
                    <h3>@translator.Translate(userLanguage, "Sections")</h3>
                    <div class="gb-row stack">
                        <ul class="gb-tablist list-unstyled m-0">
                            <li class="locked"><i class="bi bi-speedometer2"></i><label>@translator.Translate(userLanguage, "Overview")<span class="d-block small text-body-secondary fw-normal">@translator.Translate(userLanguage, "Always shown")</span></label><span class="form-switch"><input class="form-check-input" type="checkbox" value="Dashboard" id="dashboardTab" checked disabled></span></li>
                            @foreach (var navItem in sections)
                            {
                                var inputId = $"tabToggle{navItem.Mode}";
                                <li><i class="bi @navItem.Icon"></i><label for="@inputId">@translator.Translate(userLanguage, navItem.Label)<span class="d-block small text-body-secondary fw-normal">@translator.Translate(userLanguage, navItem.Help)</span></label><span class="form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" value="@navItem.Mode" id="@inputId" @(cfg.VisibleTabs.Contains(navItem.Mode) ? "checked" : "")></span></li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="gb-group">
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="defaultTab">@translator.Translate(userLanguage, "Open vehicles on")</label><p>@translator.Translate(userLanguage, "The section you see first when opening a vehicle.")</p></div>
                        <div class="gb-row-control">
                            <select class="form-select" onchange="updateSettings()" id="defaultTab">
                                <!option @(StaticHelper.DefaultTabSelected(cfg, ImportMode.Dashboard)) value="Dashboard">@translator.Translate(userLanguage, "Overview")</!option>
                                @foreach (var navItem in sections)
                                {
                                    <!option @(StaticHelper.DefaultTabSelected(cfg, navItem.Mode)) value="@navItem.Mode">@translator.Translate(userLanguage, navItem.Label)</!option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="hideSoldVehicles">@translator.Translate(userLanguage, "Hide sold vehicles")</label></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" id="hideSoldVehicles" checked="@cfg.HideSoldVehicles"></div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="showCalendar">@translator.Translate(userLanguage, "Reminder calendar")</label><p>@translator.Translate(userLanguage, "Adds a calendar of date-based reminders next to the garage.")</p></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings(true)" type="checkbox" role="switch" id="showCalendar" checked="@cfg.ShowCalendar"></div>
                    </div>
                    <div class="gb-row @(isRoot ? "" : "d-none")">
                        <div class="gb-row-text"><label for="enableShopSupplies">@translator.Translate(userLanguage, "Shop supplies")</label><p>@translator.Translate(userLanguage, "A shared stock of parts and fluids that isn't tied to one vehicle.")</p></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings(true)" type="checkbox" role="switch" id="enableShopSupplies" checked="@cfg.EnableShopSupplies"></div>
                    </div>
                </div>
            </section>

            <!-- Notifications -->
            <section class="gb-settings-page" data-settings-section="notifications">
                <header>
                    <h2>@translator.Translate(userLanguage, "Notifications")</h2>
                    <p>@translator.Translate(userLanguage, "Get reminder alerts on your phone with ntfy. Install the ntfy app, subscribe to your topic, then fill this in.")</p>
                </header>
                <form id="gbNtfyForm" onsubmit="gbSaveNtfy(); return false;">
                    <div class="gb-group">
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyEnabled">@translator.Translate(userLanguage, "Send reminder notifications")</label><p>@translator.Translate(userLanguage, "Checked every 15 minutes and right after you add a record.")</p></div>
                            <div class="gb-row-control form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyEnabled" checked="@ntfy.Enabled"></div>
                        </div>
                        <div class="gb-row stack">
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="gb-field-label mt-0" for="ntfyServerUrl">@translator.Translate(userLanguage, "Server")</label>
                                    <input type="url" class="form-control" id="ntfyServerUrl" value="@ntfy.ServerUrl" placeholder="https://ntfy.sh" autocomplete="off">
                                </div>
                                <div class="col-md-6">
                                    <label class="gb-field-label mt-0" for="ntfyTopic">@translator.Translate(userLanguage, "Topic")</label>
                                    <input type="text" class="form-control" id="ntfyTopic" value="@ntfy.Topic" placeholder="glovebox-reminders" autocomplete="off" spellcheck="false">
                                    <small class="text-body-secondary">@translator.Translate(userLanguage, "On the public ntfy.sh server anyone who knows the topic can read it, so make it hard to guess.")</small>
                                </div>
                                <div class="col-md-6">
                                    <label class="gb-field-label mt-0" for="ntfyAccessToken">@translator.Translate(userLanguage, "Access token (optional)")</label>
                                    <input type="password" class="form-control" id="ntfyAccessToken" value="" placeholder="@(string.IsNullOrWhiteSpace(ntfy.AccessToken) ? "tk_..." : translator.Translate(userLanguage, "Saved, leave blank to keep"))" autocomplete="new-password">
                                </div>
                                <div class="col-md-6">
                                    <label class="gb-field-label mt-0" for="ntfyAppUrl">@translator.Translate(userLanguage, "Open this address when tapped")</label>
                                    <input type="url" class="form-control" id="ntfyAppUrl" value="@ntfy.AppUrl" placeholder="https://glovebox.example.com" autocomplete="off">
                                </div>
                                <div class="col-12">
                                    <a class="small" data-bs-toggle="collapse" href="#gbNtfyBasicAuth" role="button" aria-expanded="@(!string.IsNullOrWhiteSpace(ntfy.Username) ? "true" : "false")">@translator.Translate(userLanguage, "Use a username and password instead")</a>
                                    <div class="collapse @(!string.IsNullOrWhiteSpace(ntfy.Username) ? "show" : "")" id="gbNtfyBasicAuth">
                                        <div class="row g-3 mt-0">
                                            <div class="col-md-6">
                                                <label class="gb-field-label mt-0" for="ntfyUsername">@translator.Translate(userLanguage, "Username")</label>
                                                <input type="text" class="form-control" id="ntfyUsername" value="@ntfy.Username" autocomplete="off">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="gb-field-label mt-0" for="ntfyPassword">@translator.Translate(userLanguage, "Password")</label>
                                                <input type="password" class="form-control" id="ntfyPassword" value="" placeholder="@(string.IsNullOrWhiteSpace(ntfy.Password) ? "" : translator.Translate(userLanguage, "Saved, leave blank to keep"))" autocomplete="new-password">
                                            </div>
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(ntfy.AccessToken) || !string.IsNullOrWhiteSpace(ntfy.Password))
                                    {
                                        <div class="form-check mt-2">
                                            <input class="form-check-input" type="checkbox" id="ntfyClearSecrets">
                                            <label class="form-check-label small" for="ntfyClearSecrets">@translator.Translate(userLanguage, "Forget the saved token and password")</label>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="gb-group">
                        <h3>@translator.Translate(userLanguage, "When to notify")</h3>
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyHeadsUp"><span class="gb-dot gb-dot--info me-2"></span>@translator.Translate(userLanguage, "Heads-up before it's due")</label><p>@translator.Translate(userLanguage, "An early warning so you have time to order parts or book the shop.")</p></div>
                            <div class="gb-row-control form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyHeadsUp" checked="@ntfy.NotifyHeadsUp"></div>
                        </div>
                        <div class="gb-row" id="gbHeadsUpDefaults">
                            <div class="gb-row-text"><strong>@translator.Translate(userLanguage, "Default heads-up")</strong><p>@translator.Translate(userLanguage, "Whichever comes first. Each reminder can override this.")</p></div>
                            <div class="gb-row-control">
                                <div class="input-group" style="width:9.5rem;"><input type="number" min="0" inputmode="numeric" class="form-control" id="ntfyHeadsUpDistance" value="@ntfy.HeadsUpDistance" aria-label="@translator.Translate(userLanguage, "Distance")"><span class="input-group-text">@distanceUnit</span></div>
                                <div class="input-group" style="width:9.5rem;"><input type="number" min="0" inputmode="numeric" class="form-control" id="ntfyHeadsUpDays" value="@ntfy.HeadsUpDays" aria-label="@translator.Translate(userLanguage, "Days")"><span class="input-group-text">@translator.Translate(userLanguage, "days")</span></div>
                            </div>
                        </div>
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyDueSoon"><span class="gb-dot gb-dot--soon me-2"></span>@translator.Translate(userLanguage, "Due soon")</label><p>@translator.Translate(userLanguage, "Within your due-soon threshold (30 days or 100 distance by default).")</p></div>
                            <div class="gb-row-control form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyDueSoon" checked="@ntfy.NotifyDueSoon"></div>
                        </div>
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyUrgent"><span class="gb-dot gb-dot--urgent me-2"></span>@translator.Translate(userLanguage, "Urgent")</label><p>@translator.Translate(userLanguage, "Within your urgent threshold (7 days or 50 distance by default).")</p></div>
                            <div class="gb-row-control form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyUrgent" checked="@ntfy.NotifyUrgent"></div>
                        </div>
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyOverdue"><span class="gb-dot gb-dot--overdue me-2"></span>@translator.Translate(userLanguage, "Overdue")</label></div>
                            <div class="gb-row-control">
                                <select class="form-select form-select-sm" id="ntfyOverdueRepeat" style="min-width:0;width:auto;" aria-label="@translator.Translate(userLanguage, "Repeat")">
                                    <!option value="0" @(ntfy.OverdueRepeatDays == 0 ? "selected" : "")>@translator.Translate(userLanguage, "Once")</!option>
                                    <!option value="1" @(ntfy.OverdueRepeatDays == 1 ? "selected" : "")>@translator.Translate(userLanguage, "Daily")</!option>
                                    <!option value="3" @(ntfy.OverdueRepeatDays == 3 ? "selected" : "")>@translator.Translate(userLanguage, "Every 3 days")</!option>
                                    <!option value="7" @(ntfy.OverdueRepeatDays == 7 ? "selected" : "")>@translator.Translate(userLanguage, "Weekly")</!option>
                                </select>
                                <span class="form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyOverdue" checked="@ntfy.NotifyOverdue"></span>
                            </div>
                        </div>
                        <div class="gb-row">
                            <div class="gb-row-text"><label for="ntfyQuiet">@translator.Translate(userLanguage, "Quiet hours")</label><p>@translator.Translate(userLanguage, "Hold notifications overnight and send them in the morning.")</p></div>
                            <div class="gb-row-control">
                                <select class="form-select form-select-sm" id="ntfyQuietStart" style="min-width:0;width:auto;" aria-label="@translator.Translate(userLanguage, "Start")">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        <!option value="@h" @(ntfy.QuietHoursStart == h ? "selected" : "")>@DateTime.Today.AddHours(h).ToString("t")</!option>
                                    }
                                </select>
                                <span class="text-body-secondary">@translator.Translate(userLanguage, "to")</span>
                                <select class="form-select form-select-sm" id="ntfyQuietEnd" style="min-width:0;width:auto;" aria-label="@translator.Translate(userLanguage, "End")">
                                    @for (int h = 0; h < 24; h++)
                                    {
                                        <!option value="@h" @(ntfy.QuietHoursEnd == h ? "selected" : "")>@DateTime.Today.AddHours(h).ToString("t")</!option>
                                    }
                                </select>
                                <span class="form-switch"><input class="form-check-input" type="checkbox" role="switch" id="ntfyQuiet" checked="@ntfy.QuietHoursEnabled"></span>
                            </div>
                        </div>
                    </div>
                    <div class="gb-group">
                        <div class="gb-row">
                            <div class="gb-row-text">
                                <strong>@translator.Translate(userLanguage, "Example")</strong>
                                <div class="gb-ntfy-preview mt-2">
                                    <img class="gb-ntfy-icon" src="/defaults/glovebox_icon_192.png" alt="" />
                                    <div>
                                        <strong>@translator.Translate(userLanguage, "Heads-up: Oil change due in 480") @distanceUnit</strong>
                                        <p>@translator.Translate(userLanguage, "2016 BMW 435i. Due at 49,000") @distanceUnit. @translator.Translate(userLanguage, "Odometer is at 48,520") @distanceUnit.</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="gb-row">
                            <div class="d-flex flex-wrap gap-2 w-100">
                                <button type="submit" class="btn btn-primary"><i class="bi bi-check2"></i>@translator.Translate(userLanguage, "Save notification settings")</button>
                                <button type="button" class="btn btn-secondary" onclick="gbTestNtfy()"><i class="bi bi-send"></i>@translator.Translate(userLanguage, "Send a test")</button>
                                <button type="button" class="btn btn-ghost" onclick="gbCheckNtfyNow()"><i class="bi bi-arrow-repeat"></i>@translator.Translate(userLanguage, "Check reminders now")</button>
                            </div>
                        </div>
                    </div>
                </form>
            </section>

            <!-- Units -->
            <section class="gb-settings-page" data-settings-section="units">
                <header>
                    <h2>@translator.Translate(userLanguage, "Units")</h2>
                    <p>@translator.Translate(userLanguage, "Units apply to how values are shown and calculated. Existing records aren't converted.")</p>
                </header>
                <div class="gb-group">
                    <div class="gb-row">
                        <div class="gb-row-text"><strong>@translator.Translate(userLanguage, "Distance and fuel")</strong><p>@translator.Translate(userLanguage, "Imperial uses miles, gallons and MPG. Metric uses kilometers, liters and L/100km.")</p></div>
                        <div class="gb-row-control">
                            <div class="gb-segmented" role="radiogroup">
                                <input type="radio" name="gbUnits" id="unitsImperial" value="imperial" @(cfg.UseMPG ? "checked" : "") onchange="updateSettings(true)"><label for="unitsImperial">@translator.Translate(userLanguage, "Imperial")</label>
                                <input type="radio" name="gbUnits" id="unitsMetric" value="metric" @(!cfg.UseMPG ? "checked" : "") onchange="updateSettings(true)"><label for="unitsMetric">@translator.Translate(userLanguage, "Metric")</label>
                            </div>
                        </div>
                    </div>
                    <div class="gb-row">
                        <div class="gb-row-text"><label for="useUKMPG">@translator.Translate(userLanguage, "UK gallons")</label><p>@translator.Translate(userLanguage, "Enter fuel in liters; MPG is calculated with imperial (UK) gallons.")</p></div>
                        <div class="gb-row-control form-switch"><input class="form-check-input" onchange="updateSettings()" type="checkbox" role="switch" id="useUKMPG" checked="@cfg.UseUKMPG"></div>
                    </div>
